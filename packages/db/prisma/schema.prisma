// Beermacs — Prisma schema
//
// Connection strategy (Prisma 7 — see prisma.config.ts + docs/SETUP.md):
//   - Runtime client uses a DRIVER ADAPTER (@prisma/adapter-pg) built from
//     DATABASE_URL (Neon POOLED `-pooler` host). See src/index.ts.
//   - Migrations/introspection use DIRECT_URL (Neon UNPOOLED host), configured
//     as the CLI `datasource` in prisma.config.ts.
//
// DESIGN NOTES (see docs/ARCHITECTURE.md):
//
//   - THE PHONE HAS NO DATABASE CREDENTIALS. There is no row-level security
//     here, because there is no client-to-Postgres connection to secure: the
//     mobile app calls route handlers in apps/web, which are the only thing
//     holding DATABASE_URL. Every authorisation check therefore lives in the
//     API layer, calling the same pure functions from @beermacs/shared that the
//     app uses to render. That is deliberate — the original web app put its
//     admin gate in a React modal and its permissions in policies that were all
//     `USING (true)`.
//
//   - MATCH RESULTS ARE APPEND-ONLY. `MatchReport` is never updated or
//     deleted; a disagreement adds a row rather than editing one. The match's
//     settled winner is a separate, mutable field on Match, written only by the
//     transition function. This is what makes a dispute reconstructable.
//
//   - STAFF OVERRIDES ARE ALWAYS AUDITED. Anything that forces a transition
//     writes an AuditEntry. The old repo's last eight commits were hand-written
//     SQL swapping semifinal teams against production, with no record of who
//     did it or why.
//
//   - Soft delete via `deletedAt` where history matters.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ───────────────────────────────────────────────────────────────

enum Role {
  PLAYER // default. Joins tournaments, reports own results.
  VENUE_STAFF // runs the night: seed, assign tables, resolve disputes.
  VENUE_ADMIN // as staff, plus tournaments, tables, news, broadcasts.
  VENUE_OWNER // as admin, plus billing and staff management.
}

/// A person. One account can be a PLAYER at one venue and VENUE_ADMIN at
/// another — roles are per-venue (see VenueMembership), never global. The bar
/// owner plays too.
model User {
  id String @id @default(cuid())

  /// Better Auth writes `name`, `email`, `emailVerified` and `image` by these
  /// exact names, so they are not renamed. `displayName` is what the app shows
  /// and what a player types when joining; it defaults from `name`.
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?

  /// Nullable: players join anonymously and may never give us contact details.
  /// Auth identifiers are added only if they want their record to follow them
  /// between nights.
  phone         String?  @unique
  phoneVerified Boolean  @default(false)
  /// Defaulted, not required: an anonymous session is created the moment the
  /// app opens, before the player has typed anything. The join endpoint
  /// overwrites this with the name they actually enter.
  displayName   String   @default("Player")

  /// Set by Better Auth's anonymous plugin. An anonymous user is a real row
  /// with a real session — team membership and push notifications work exactly
  /// the same — it just has no way to sign in again from another device.
  isAnonymous Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions      Session[]
  accounts      Account[]
  memberships   VenueMembership[]
  directMessagesReceived ChatChannel[] @relation("DirectMessageRecipient")
  teamMembers   TeamMember[]
  devices       Device[]
  messages      ChatMessage[]
  reports       MatchReport[]
  auditEntries  AuditEntry[]      @relation("AuditActor")
  authoredNews  News[]            @relation("NewsAuthor")
  blocked       BlockedUser[]     @relation("Blocker")
  blockedBy     BlockedUser[]     @relation("Blocked")
  mutedIn       MutedPlayer[]     @relation("MutedUser")
  mutedByStaff  MutedPlayer[]     @relation("MutedByStaff")

  @@index([deletedAt])
}

/// Better Auth session. Managed entirely by the library — do not write to it.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Better Auth credential/provider link. Holds the staff password hash.
///
/// `issuer` arrived in Better Auth 1.7, which scopes account identity by it.
/// The exact field list here came from calling `getAuthTables()` with our own
/// plugin set rather than from copying another project's schema — that is what
/// the missing column was.
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Better Auth short-lived tokens (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// The tenant. Everything below hangs off a venue.
model Venue {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  city     String?
  /// For the "venues running a tournament near me" map on Home.
  latitude  Float?
  longitude Float?
  logoUrl  String?
  timezone String  @default("Europe/Rome")

  /// Present from day one even though billing is not built, so adding it later
  /// is not a migration against live tournament data. See docs/ROADMAP.md.
  subscriptionStatus SubscriptionStatus @default(TRIALING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships VenueMembership[]
  tables      VenueTable[]
  tournaments Tournament[]
  news        News[]

  @@index([deletedAt])
}

/// Role is per-venue, which is the whole point: a single account can play at
/// one bar and run the night at another.
model VenueMembership {
  id        String   @id @default(cuid())
  userId    String
  venueId   String
  role      Role     @default(PLAYER)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([venueId, role])
}

// ─── Tables ─────────────────────────────────────────────────────────────────

enum TableState {
  OPEN
  BUSY
  /// Pulled out of rotation by staff — wobbly leg, someone spilled a pint.
  CLOSED
}

/// A physical table. `label` is what staff shout across the room, so it is free
/// text ("Table 3", "Patio", "Upstairs") rather than an integer.
model VenueTable {
  id        String     @id @default(cuid())
  venueId   String
  label     String
  state     TableState @default(OPEN)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  matches Match[]

  @@unique([venueId, label])
  @@index([venueId, sortOrder])
}

// ─── Tournaments ────────────────────────────────────────────────────────────

/// A-5: the standard case is single elimination, but the admin must be free to
/// run other structures. Mirrors TournamentFormatKind in @beermacs/shared.
/// `TRIANGULAR` is a fixed group size of 3, everyone plays everyone — the same
/// Stage/Group machinery as GROUP_THEN_KNOCKOUT with a different grouping step,
/// not a separate engine.
enum TournamentFormatKind {
  SINGLE_ELIMINATION
  GROUP_THEN_KNOCKOUT
  TRIANGULAR
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  RUNNING
  COMPLETE
  CANCELED
}

model Tournament {
  id      String               @id @default(cuid())
  venueId String
  name    String
  /// A-6: this is a plain field update, not a migration — changing the format
  /// mid-tournament is meant to be cheap. Which STRUCTURE the engine runs.
  format  TournamentFormatKind @default(SINGLE_ELIMINATION)
  status  TournamentStatus     @default(DRAFT)

  /// Six characters, Crockford Base32 — see @beermacs/shared join-code.ts.
  /// Printed on the table tent, read aloud in a loud room.
  joinCode String @unique

  startsAt DateTime?

  /// Tunable knobs beyond the structural `format`: playersPerTeam (A-1),
  /// chatEnabled (A-2), autoRepechageMode (A-10's default for E-8),
  /// confirmTimeoutMins, cupsToWin (null = this format doesn't score matches).
  /// Shape lives in @beermacs/shared as TournamentFormat minus `kind`, which is
  /// the `format` column above — the API merges the two when serialising.
  config Json @default("{}")

  /// There is no `currentRound` scalar. Which round is "current" is a
  /// derived question — see Round.status below — not a value to keep in sync.

  championTeamId String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  venue        Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  stages       Stage[]
  teams        Team[]
  matches      Match[]
  chatChannels ChatChannel[]
  auditEntries AuditEntry[]
  champion     Team?        @relation("Champion", fields: [championTeamId], references: [id])
  mutedPlayers MutedPlayer[]

  @@index([venueId, status])
}

enum StageType {
  GROUP
  ELIMINATION
}

/// A tournament is a sequence of stages. GROUP_THEN_ELIMINATION has two; plain
/// ELIMINATION has one. This is what keeps the bracket engine format-agnostic.
model Stage {
  id           String    @id @default(cuid())
  tournamentId String
  type         StageType
  /// 0-based position in the tournament.
  order        Int
  /// For a group stage: how many teams per group advance.
  advanceCount Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groups     Group[]
  rounds     Round[]
  matches    Match[]

  @@unique([tournamentId, order])
}

model Group {
  id      String @id @default(cuid())
  stageId String
  /// "A", "B", … Shown on the standings table.
  label   String

  stage   Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  matches Match[]
  members GroupMember[]

  @@unique([stageId, label])
}

/// Which teams are in which group. A join table rather than a Team.groupId,
/// because a team belongs to a group only for the group stage and then moves
/// into the bracket.
model GroupMember {
  id      String @id @default(cuid())
  groupId String
  teamId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([groupId, teamId])
}

/// A-13: a round's own lifecycle. NOT_OPENED is where every round starts,
/// including round 1 — the spec is explicit that round 1 exists conceptually,
/// with teams already counted as belonging to it, before anyone has opened it
/// (E-7). There is no CLOSED state: nothing in the spec asks a round to ever
/// shut, and A-8's "no fixed cut-off" for adding teams reads most naturally as
/// "a round, once open, stays a valid target forever."
enum RoundStatus {
  NOT_OPENED
  OPEN
}

model Round {
  id      String      @id @default(cuid())
  stageId String
  /// 1-based, matches Match.position's round for display.
  index   Int
  status  RoundStatus @default(NOT_OPENED)
  /// A-15: pause automatic dispatch into this round without tearing anything
  /// down. Matches already on a table are unaffected.
  schedulingPaused Boolean @default(false)

  createdAt DateTime @default(now())

  stage    Stage          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  matches  Match[]
  entrants RoundEntrant[]

  @@unique([stageId, index])
}

/// Explicit, auditable membership: a team becomes an entrant of a round only
/// when something says so — initial registration (E-7), a winner advancing
/// (an explicit step the API takes on confirming a match, not an implicit
/// recomputation), or a repêchage draw (A-9). This is what lets
/// `waitingTeams()` in @beermacs/shared answer "who hasn't played yet in this
/// round" (E-3) without reconstructing the whole match history every time.
model RoundEntrant {
  id      String  @id @default(cuid())
  roundId String
  teamId  String
  /// True if this entry came from a repêchage draw (E-8/A-9) rather than
  /// natural entry or advancement.
  viaRepechage Boolean @default(false)

  createdAt DateTime @default(now())

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([roundId, teamId])
  @@index([teamId])
}

// ─── Teams ──────────────────────────────────────────────────────────────────

model Team {
  id           String @id @default(cuid())
  tournamentId String
  name         String

  /// E-6/E-7: the round this team's participation starts at. Every team formed
  /// before round 1 opens gets 1; a team added mid-tournament (A-7 — there is
  /// no cut-off, A-8) gets whichever round was the lowest OPEN one the moment
  /// it joined. Fixed at creation, never recomputed.
  entryRound Int     @default(1)
  /// A-8: the admin can remove a team at any point. Soft, not deleted — a
  /// withdrawn team's match history stays intact for the bracket display.
  withdrawn  Boolean @default(false)

  createdAt DateTime @default(now())

  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  groupMembers GroupMember[]
  roundEntries RoundEntrant[]
  homeMatches  Match[]       @relation("HomeTeam")
  awayMatches  Match[]       @relation("AwayTeam")
  wonMatches   Match[]       @relation("Winner")
  reports      MatchReport[]
  chatChannels ChatChannel[]
  wonChampionship Tournament? @relation("Champion")

  @@unique([tournamentId, name])
  @@index([tournamentId, entryRound])
}

model TeamMember {
  id       String  @id @default(cuid())
  teamId   String
  userId   String
  /// First person to claim the team. Captains report and confirm results.
  isCaptain Boolean @default(false)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ─── Matches ────────────────────────────────────────────────────────────────

/// Mirrors MatchState in @beermacs/shared. The old app had three states and set
/// the winner with a client-side UPDATE, so any team could declare itself the
/// winner. These six exist so "both teams approved" is a state the server can
/// check rather than a promise the UI makes.
enum MatchState {
  /// Slots not both filled, or feeders unfinished. Not playable.
  SCHEDULED
  /// Playable, waiting for a table. In the dispatcher queue.
  QUEUED
  /// On a physical table, clock running.
  ON_TABLE
  /// One captain has reported; the other side has not answered.
  REPORTED
  /// The other side rejected, or nobody answered within the timeout.
  DISPUTED
  /// Settled. winnerTeamId and scores are final.
  CONFIRMED
}

model Match {
  id           String @id @default(cuid())
  tournamentId String
  stageId      String
  roundId      String
  /// Set only for group-stage matches.
  groupId      String?

  /// Index within the round, 0-based. Drives bracket layout.
  position Int

  homeTeamId String?
  awayTeamId String?
  /// Re-entered via repêchage (A-9). Rendered with a 🍀 in the bracket.
  homeViaRepechage Boolean @default(false)
  awayViaRepechage Boolean @default(false)

  state MatchState @default(SCHEDULED)

  /// Written ONLY by the result transition in @beermacs/shared, called from a
  /// route handler. Never set directly from a client payload.
  winnerTeamId String?
  /// Optional — U-11 only asks who won. Beer pong can still record a score;
  /// a triangular or group format may have nothing to score at all.
  homeScore    Int?
  awayScore    Int?

  venueTableId String?
  /// When the dispatcher sent it to a table — drives the "you're up" push.
  calledAt     DateTime?
  settledAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tournament Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage      Stage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  round      Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  group      Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  homeTeam   Team?         @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam   Team?         @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  winner     Team?         @relation("Winner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  venueTable VenueTable?   @relation(fields: [venueTableId], references: [id], onDelete: SetNull)
  reports    MatchReport[]
  channel    ChatChannel?

  @@unique([roundId, position])
  @@index([tournamentId, state])
  @@index([venueTableId])
}

enum ReportKind {
  /// A captain claiming a result.
  CLAIM
  /// The other captain agreeing with the standing claim.
  CONFIRM
  /// The other captain disagreeing.
  REJECT
  /// Nobody answered inside the tournament's confirmTimeoutMins.
  TIMEOUT
  /// Staff settling it. Requires a reason.
  STAFF_RESOLVE
}

/// APPEND-ONLY. A disagreement adds a row; it never edits one. This is what
/// makes a dispute reconstructable — staff resolving it can see exactly what
/// each side claimed, and when.
model MatchReport {
  id      String     @id @default(cuid())
  matchId String
  kind    ReportKind

  /// Null for TIMEOUT (raised by a scheduled job, not a person).
  actorUserId String?
  /// The team the actor was reporting for. Null for staff actions.
  teamId      String?

  claimedWinnerTeamId String?
  homeScore           Int?
  awayScore           Int?
  reason              String?

  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  team  Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([matchId, createdAt])
}

// ─── Audit ──────────────────────────────────────────────────────────────────

/// Every staff action that forces a transition or edits a bracket. The answer
/// to "who changed the semifinal?", which the old app could not give.
model AuditEntry {
  id           String  @id @default(cuid())
  tournamentId String
  actorUserId  String?
  /// e.g. "match.staff_resolve", "bracket.swap_slots", "team.remove".
  action       String
  reason       String?
  /// Before/after snapshots of whatever changed.
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  actor      User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tournamentId, createdAt])
}

// ─── News ───────────────────────────────────────────────────────────────────

/// The announcement feed on Home. The primary advertising surface, and the
/// trigger for a broadcast push.
///
/// `venueId` is NULLABLE on purpose: a null venue is a platform-wide post from
/// us, which everyone sees regardless of which bar they are at. A venue post is
/// only shown to people at that venue. Both render identically apart from the
/// byline, so one feed and one composer serve both.
model News {
  id          String    @id @default(cuid())
  venueId     String?
  authorId    String?
  title       String
  body        String
  imageUrl    String?
  publishedAt DateTime?
  /// Whether publishing also sent a push to the venue's players.
  pushSentAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  venue  Venue? @relation(fields: [venueId], references: [id], onDelete: Cascade)
  author User?  @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([venueId, publishedAt])
  @@index([publishedAt])
}

// ─── Chat ───────────────────────────────────────────────────────────────────

enum ChannelKind {
  /// Everyone playing tonight. U-9: only exists if the tournament's format
  /// enables chat at all.
  TOURNAMENT
  /// U-8: auto-created when a match goes on a table, archived on settle.
  /// Includes both teams' members — U-10 lets an admin read and post in any.
  MATCH
  /// A-18: admin → one team.
  TEAM
  /// A-18/A-19: admin → one specific person, or a broadcast to everyone.
  /// `recipientUserId` set = direct message; null = broadcast (A-19, and every
  /// message in it triggers a push per that clause).
  DIRECT
  /// Staff write, everyone reads. Distinct from DIRECT-with-no-recipient only
  /// in that it's a standing channel rather than a one-off send.
  BROADCAST
}

model ChatChannel {
  id           String      @id @default(cuid())
  tournamentId String
  kind         ChannelKind
  /// Set only for MATCH channels.
  matchId        String?     @unique
  /// Set only for TEAM channels (A-18).
  teamId         String?
  /// Set only for DIRECT channels aimed at one person (A-18); null on a
  /// DIRECT channel means the send target was "everyone" (A-19).
  recipientUserId String?
  archivedAt   DateTime?
  createdAt    DateTime    @default(now())

  tournament Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match      Match?        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team       Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  recipient  User?         @relation("DirectMessageRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@index([tournamentId, kind])
  @@index([teamId])
  @@index([recipientUserId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  /// Soft delete so staff removal is auditable and reversible.
  deletedAt DateTime?
  /// Set when a viewer reports it. App Store guideline 1.2 requires a report
  /// path for user-generated content before the app can ship with chat.
  flaggedAt DateTime?

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
}

/// A player hiding another player's messages from themselves (App Store
/// guideline 1.2's "block"). Personal and mutual only in effect, not in
/// storage — A blocking B does not stop B from seeing A's messages, so this
/// is a one-directional row, checked from the reader's side at query time.
model BlockedUser {
  id            String   @id @default(cuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

/// Staff silencing a player across every chat in ONE tournament (guideline
/// 1.2's "mute" — distinct from BlockedUser, which is a player's own choice
/// about their own view). Scoped to a tournament, not the venue or the app,
/// because a mute is a response to that night's behaviour, not a permanent
/// judgement — matches how VenueMembership roles are scoped, but per-
/// tournament instead of per-venue since the misbehaviour is per-tournament.
model MutedPlayer {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  mutedById    String
  reason       String?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation("MutedUser", fields: [userId], references: [id], onDelete: Cascade)
  mutedBy    User       @relation("MutedByStaff", fields: [mutedById], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId])
}

// ─── Push ───────────────────────────────────────────────────────────────────

enum Platform {
  IOS
  ANDROID
}

/// One row per install. The Expo push token, not a raw APNs/FCM token — sends
/// go through Expo's push service from a route handler in apps/web.
model Device {
  id            String   @id @default(cuid())
  userId        String
  expoPushToken String   @unique
  platform      Platform
  /// Per-category opt-outs, e.g. { news: false, yourTurn: true }. A player who
  /// mutes announcements must still get "you're up — Table 3".
  preferences   Json     @default("{}")
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
