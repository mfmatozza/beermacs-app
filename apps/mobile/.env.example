# =============================================================================
# apps/mobile — environment variables (Expo)
# Copy to `.env.local` and fill in. NEVER commit the real file.
# IMPORTANT: use `.env.local`, not `.env` — EAS Build loads `.env` into cloud
# builds (staging/production), so a `.env` here would bake a local override into
# the shipped app. `.env.local` is local-only by Expo's own convention.
#
# ⚠️  EXPO_PUBLIC_* variables are PUBLIC BY DEFINITION. They are inlined into the
#     JS bundle shipped to devices and can be read by anyone with the app.
#     NEVER put secrets here. The Supabase service-role key must NOT exist in
#     the mobile bundle — the old web app shipped its admin password in the
#     bundle and that is exactly the mistake this file exists to prevent.
# =============================================================================

# Selects behaviour and, later, which Supabase project: development | staging | production.
APP_ENV="development"

# ── Supabase (arrives in phase 1 — see docs/ROADMAP.md) ──────────────────────
# The anon key is public by design: it is only as powerful as the row-level
# security policies behind it, which is why RLS is written in the first
# migration rather than added later.
EXPO_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="eyJxxxx"
