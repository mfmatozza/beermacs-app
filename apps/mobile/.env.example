# =============================================================================
# apps/mobile — environment variables (Expo)
# Copy to `.env.local` and fill in. NEVER commit the real file.
# IMPORTANT: use `.env.local`, not `.env` — EAS Build loads `.env` into cloud
# builds (staging/production), so a `.env` here would bake a local override into
# the shipped app. `.env.local` is local-only by Expo's own convention.
#
# ⚠️  EXPO_PUBLIC_* variables are PUBLIC BY DEFINITION. They are inlined into the
#     JS bundle shipped to devices and can be read by anyone with the app.
#     NEVER put a secret here.
#
#     There is deliberately NO database URL in this file. The phone holds no
#     database credentials and never connects to Postgres — it calls apps/web,
#     which is the only thing that talks to Neon. The original web app shipped
#     its admin password in the JS bundle; this is the structural fix for that
#     class of mistake, not just a rule about what to paste here.
# =============================================================================

# Base URL of the deployed apps/web instance the app talks to (dev override).
# Staging/production URLs are baked per EAS profile in app.config.ts.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Selects which API_URL app.config.ts uses: development | staging | production.
APP_ENV="development"
