# =============================================================================
# apps/web — environment variables (Next.js)
# Copy to `.env.local` and fill in. NEVER commit the real file.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# public. Everything else is server-only and must stay that way.
# =============================================================================

# ── Supabase (arrives in phase 1 — see docs/ROADMAP.md) ──────────────────────
# The anon key is public by design; it is only as powerful as the row-level
# security policies behind it.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJxxxx"

# SERVER ONLY. Bypasses row-level security entirely. Never prefix this
# NEXT_PUBLIC_, never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY="eyJxxxx"
