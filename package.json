{
  "name": "beermacs",
  "private": true,
  "version": "0.0.0",
  "description": "Beermacs — beer pong tournament platform for bars (monorepo: mobile + web/api)",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run db:generate",
    "db:generate": "npm run generate -w @beermacs/db",
    "db:migrate": "npm run migrate -w @beermacs/db",
    "db:studio": "npm run studio -w @beermacs/db",
    "db:seed": "npm run seed -w @beermacs/db"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.17",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
